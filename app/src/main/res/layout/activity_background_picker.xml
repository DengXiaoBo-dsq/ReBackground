<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/transparent">

    <!-- 预览区域：占据剩余所有空间 -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controlContainer">

        <!-- 背景层（用于显示颜色/图片） -->
        <ImageView
            android:id="@+id/background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@android:color/transparent"/>

        <!-- 背景图片（与 background 叠加，实际使用时互斥） -->
        <ImageView
            android:id="@+id/backgroundImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>

        <!-- 前景图片（可变换） -->
        <ImageView
            android:id="@+id/foregroundImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="matrix"/>
    </FrameLayout>

    <!-- 控制区域：高度自适应内容 -->
    <LinearLayout
        android:id="@+id/controlContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/previewContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer">

        <!-- 缩放控制行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="缩放:"
                android:textColor="@color/light_text"/>

            <SeekBar
                android:id="@+id/seekBarScale"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:max="4000"
                android:progress="1000"/>
        </LinearLayout>

        <!-- 水平移动控制行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="水平移动:"
                android:textColor="@color/light_text"/>

            <SeekBar
                android:id="@+id/seekBarTranslateX"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:max="1000"
                android:progress="500"/>
        </LinearLayout>

        <!-- 垂直移动控制行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="垂直移动:"
                android:textColor="@color/light_text"/>

            <SeekBar
                android:id="@+id/seekBarTranslateY"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:max="1000"
                android:progress="500"/>
        </LinearLayout>

        <!-- 旋转控制行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="旋转:"
                android:textColor="@color/light_text"/>

            <SeekBar
                android:id="@+id/seekBarRotate"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:max="1080"
                android:progress="0"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 按钮区域：高度自适应内容，且按钮内边距增加以保证文字完整 -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/controlContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnSelectImage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="选择图片"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/lisu"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:minWidth="0dp"/>

        <Button
            android:id="@+id/btnSelectColor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="选择颜色"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/lisu"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:minWidth="0dp"/>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="保存效果"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/lisu"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:minWidth="0dp"/>

        <Button
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="重来"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/lisu"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:minWidth="0dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>