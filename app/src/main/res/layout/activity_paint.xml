<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E">

    <!-- 顶部工具栏 -->
    <LinearLayout
        android:id="@+id/toolbar_top"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2A2A2A"
        android:paddingHorizontal="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <!-- 左侧标题 -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="绘画"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 右侧按钮组 -->
        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_undo"
            android:background="@drawable/icon_button_bg"
            android:tint="#FFFFFF"
            android:contentDescription="撤销" />

        <ImageButton
            android:id="@+id/btnRedo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_redo"
            android:background="@drawable/icon_button_bg"
            android:tint="#FFFFFF"
            android:contentDescription="重做"
            android:layout_marginStart="4dp" />

        <ImageButton
            android:id="@+id/btnResetTransform"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_reset"
            android:background="@drawable/icon_button_bg"
            android:tint="#FFFFFF"
            android:contentDescription="重置变换"
            android:layout_marginStart="4dp" />

        <ImageButton
            android:id="@+id/btnLayers"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_layers"
            android:background="@drawable/icon_button_bg"
            android:tint="#FFFFFF"
            android:contentDescription="图层"
            android:layout_marginStart="4dp" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_settings"
            android:background="@drawable/icon_button_bg"
            android:tint="#FFFFFF"
            android:contentDescription="设置"
            android:layout_marginStart="4dp" />
    </LinearLayout>


    <FrameLayout
        android:id="@+id/paintCanvasHost"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_top"
        app:layout_constraintBottom_toTopOf="@+id/toolbar_bottom"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">



        <!-- 3. 新画布（GLSurfaceView）：透明背景，浮在画板之上 -->
        <com.dsq.rebackground.paint.rendering.gl.PaintGLSurfaceView
            android:id="@+id/paintGlSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 底部工具栏 -->
    <LinearLayout
        android:id="@+id/toolbar_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2A2A2A"
        android:paddingHorizontal="6dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <!-- 1. 画笔选择按钮 -->
        <LinearLayout
            android:id="@+id/brushSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/selector_brush_button"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="选择画笔">

            <!-- 缩略图 -->
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/brush_icon_border">

                <ImageView
                    android:id="@+id/currentBrushIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_brush_default" />
            </FrameLayout>

            <!-- 文字部分：两行 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/brushLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="画笔"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/currentBrushName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="80dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="未选择"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. 颜色按钮 -->
        <ImageButton
            android:id="@+id/btnColor"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/circle_color_preview"
            android:contentDescription="颜色"
            android:layout_marginStart="6dp" />

        <!-- 3. 粗细滑块 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="6dp">

            <SeekBar
                android:id="@+id/brushSizeSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="79"
                android:progress="9"
                android:thumbTint="#FF9800"
                android:progressTint="#FF9800" />

            <TextView
                android:id="@+id/brushSizeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:minWidth="24dp"
                android:gravity="center" />
        </LinearLayout>

        <!-- 4. 橡皮擦 -->
        <ImageButton
            android:id="@+id/btnEraser"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_eraser"
            android:background="@drawable/icon_button_bg"
            android:tint="#FFFFFF"
            android:contentDescription="橡皮擦"
            android:layout_marginStart="6dp" />

        <!-- 5. 清空 -->
        <ImageButton
            android:id="@+id/btnClear"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_clear"
            android:background="@drawable/icon_button_bg"
            android:tint="#FFFFFF"
            android:contentDescription="清空"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>