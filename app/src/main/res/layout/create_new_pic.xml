<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E"
    android:padding="16dp"
    tools:context=".CreateImageSettingsActivity">

    <!-- 标题 -->
    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="新建画布"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="20dp" />

    <!-- 预设尺寸标签 -->
    <TextView
        android:id="@+id/presetLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="预设尺寸"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintLeft_toLeftOf="parent" />

    <!-- 预设尺寸网格（横向滚动） -->
    <HorizontalScrollView
        android:id="@+id/presetScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/presetLabel"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/preset_3_4"
                style="@style/PresetButtonStyle"
                android:text="3:4\n1080×1440" />
            <Button
                android:id="@+id/preset_1_1"
                style="@style/PresetButtonStyle"
                android:text="1:1\n1080×1080" />
            <Button
                android:id="@+id/preset_16_9"
                style="@style/PresetButtonStyle"
                android:text="16:9\n1920×1080" />
            <Button
                android:id="@+id/preset_4_3"
                style="@style/PresetButtonStyle"
                android:text="4:3\n1440×1080" />
            <Button
                android:id="@+id/preset_screen"
                style="@style/PresetButtonStyle"
                android:text="屏幕\n1080×2340" />
            <Button
                android:id="@+id/preset_a4"
                style="@style/PresetButtonStyle"
                android:text="A4\n1240×1754" />
            <Button
                android:id="@+id/preset_a5"
                style="@style/PresetButtonStyle"
                android:text="A5\n874×1240" />
            <Button
                android:id="@+id/preset_custom"
                style="@style/PresetButtonStyle"
                android:text="自定义" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 自定义尺寸输入区域 -->
    <LinearLayout
        android:id="@+id/customSizeLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/presetScroll"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="自定义"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginEnd="12dp" />

        <EditText
            android:id="@+id/widthInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="宽"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:inputType="number"
            android:background="@drawable/edittext_bg"
            android:padding="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="×"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/heightInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="高"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:inputType="number"
            android:background="@drawable/edittext_bg"
            android:padding="10dp" />
    </LinearLayout>

    <!-- 背景颜色和纹理 -->
    <LinearLayout
        android:id="@+id/colorTextureLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/customSizeLayout"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="背景"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginEnd="12dp" />

        <!-- 颜色预览（点击选择颜色） -->
        <View
            android:id="@+id/colorPreview"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/colorHexText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#FFFFFF"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginEnd="16dp" />

        <!-- 纹理选择（简化） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="纹理"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <Spinner
            android:id="@+id/textureSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/spinner_bg"
            android:popupBackground="#333333"
            android:entries="@array/texture_array" />
    </LinearLayout>

    <!-- 创建按钮 -->
    <ImageButton
        android:id="@+id/btnPickImage"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_folder"
        android:background="@android:color/transparent"
        android:tint="#FFFFFF"
        android:contentDescription="选择图片"
        android:layout_marginStart="8dp" />
    <!-- 在 ImageButton 之后添加 -->
    <Button
        android:id="@+id/btnImportDraft"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="导入草稿"
        android:textColor="#FFFFFF"
        android:background="@drawable/button_secondary"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnPickImage"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />
    <Button
        android:id="@+id/createButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="创建画布"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/button_primary"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/colorTextureLayout"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>