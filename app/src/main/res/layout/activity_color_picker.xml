<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1E1E1E">

    <!-- 标题行 + 切换按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="选择颜色"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center_horizontal"/>
        <Button
            android:id="@+id/btnSwitchStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="切换样式"
            android:background="#333333"
            android:textColor="#FFFFFF"
            android:padding="8dp"/>
    </LinearLayout>

    <!-- 色盘容器 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp">

        <!-- 样式1：三段断开式（HSV） -->
        <com.madrapps.pikolo.HSLColorPicker
            android:id="@+id/colorPickerStyle1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="0dp"
            app:arc_width="20dp"
            app:radius_offset="15dp"
            app:indicator_radius="14dp"
            app:indicator_stroke_color="#FFFFFF"
            app:indicator_stroke_width="2dp"
            app:hue_arc_length="95"
            app:saturation_arc_length="95"
            app:lightness_arc_length="95"
            app:hue_start_angle="30"
            app:saturation_start_angle="150"
            app:lightness_start_angle="270"
            app:hue_indicator_stroke_color="#FFFFFF"
            app:saturation_indicator_stroke_color="#FFFFFF"
            app:lightness_indicator_stroke_color="#FFFFFF" />

        <!-- 样式2：拆分层式（H整圆在外，S+V弧在内） -->
        <FrameLayout
            android:id="@+id/colorPickerStyle2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- 外层：H 整圆（360°）只显示 H 指示器 -->
            <com.madrapps.pikolo.HSLColorPicker
                android:id="@+id/colorPickerOuter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="0dp"
                app:arc_width="20dp"
                app:radius_offset="5dp"
                app:indicator_radius="14dp"
                app:indicator_stroke_color="#FFFFFF"
                app:indicator_stroke_width="2dp"
                app:hue_arc_length="360"
                app:saturation_arc_length="0"
                app:lightness_arc_length="0"
                app:hue_indicator_radius="14dp"
                app:saturation_indicator_radius="0dp"
                app:lightness_indicator_radius="0dp"
                app:hue_indicator_stroke_color="#FFFFFF"
                app:saturation_indicator_stroke_color="@android:color/transparent"
                app:lightness_indicator_stroke_color="@android:color/transparent" />

            <!-- 内层：S 和 V 弧（各160°，间隙40°），只显示 S 和 V 指示器 -->
            <com.madrapps.pikolo.HSLColorPicker
                android:id="@+id/colorPickerInner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="0dp"
                app:arc_width="20dp"
                app:radius_offset="55dp"
                app:indicator_radius="14dp"
                app:indicator_stroke_color="#FFFFFF"
                app:indicator_stroke_width="2dp"
                app:hue_arc_length="0"
                app:saturation_arc_length="160"
                app:lightness_arc_length="160"
                app:saturation_start_angle="0"
                app:lightness_start_angle="180"
                app:hue_indicator_radius="0dp"
                app:saturation_indicator_radius="14dp"
                app:lightness_indicator_radius="14dp"
                app:saturation_indicator_stroke_color="#FFFFFF"
                app:lightness_indicator_stroke_color="#FFFFFF"
                app:hue_indicator_stroke_color="@android:color/transparent" />
        </FrameLayout>

        <!-- 样式3：RGB三段断开式 -->
        <com.madrapps.pikolo.RGBColorPicker
            android:id="@+id/colorPickerStyle3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="0dp"
            android:visibility="gone"
            app:arc_width="20dp"
            app:radius_offset="15dp"
            app:indicator_radius="14dp"
            app:indicator_stroke_color="#FFFFFF"
            app:indicator_stroke_width="2dp"
            app:arc_length="95"
            app:red_start_angle="30"
            app:green_start_angle="150"
            app:blue_start_angle="270"
            app:red_indicator_stroke_color="#FFFFFF"
            app:green_indicator_stroke_color="#FFFFFF"
            app:blue_indicator_stroke_color="#FFFFFF" />

        <!-- 中心显示当前颜色的小圆（所有样式共用） -->
        <View
            android:id="@+id/centerColorCircle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:background="@drawable/circle_white_border" />
    </FrameLayout>

    <!-- 透明度滑块 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="透明度"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"
            android:minWidth="32dp"/>
        <SeekBar
            android:id="@+id/alphaSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="255"
            android:progress="255"
            android:thumbTint="#FFFFFF"/>
        <TextView
            android:id="@+id/alphaText"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="255"
            android:textColor="#FFFFFF"
            android:textAlignment="viewEnd"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- 颜色数值输入行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HEX"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>
        <EditText
            android:id="@+id/etHex"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="wrap_content"
            android:hint="#FFFFFFFF"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:inputType="text"
            android:maxLength="9"
            android:background="#DD333333"
            android:padding="4dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"/>
        <EditText
            android:id="@+id/etR"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="3"
            android:textColor="#FFFFFF"
            android:background="#DD333333"
            android:padding="4dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="G"
            android:textColor="#FFFFFF"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
        <EditText
            android:id="@+id/etG"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="3"
            android:textColor="#FFFFFF"
            android:background="#DD333333"
            android:padding="4dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="B"
            android:textColor="#FFFFFF"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
        <EditText
            android:id="@+id/etB"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="3"
            android:textColor="#FFFFFF"
            android:background="#DD333333"
            android:padding="4dp"/>
    </LinearLayout>

    <!-- 当前颜色预览（圆形）+ 操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前颜色"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>
        <!-- 预览色块（将在代码中设为圆形） -->
        <View
            android:id="@+id/currentColorPreview"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp" />
        <Button
            android:id="@+id/btnAddFavorite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="收藏"
            android:background="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>
        <ImageButton
            android:id="@+id/btnGallery"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_folder"
            android:background="@android:color/transparent"
            android:contentDescription="图片取色"
            android:tint="#FFFFFF"
            android:layout_marginEnd="8dp"/>
    </LinearLayout>

    <!-- 收藏颜色区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="收藏颜色"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>
            <ImageButton
                android:id="@+id/btnMoreFavorites"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_more_vert"
                android:background="@android:color/transparent"
                android:tint="#FFFFFF"
                android:visibility="gone"
                android:contentDescription="更多收藏夹"/>
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/favoritesScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/favoritesContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvNoFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="暂无收藏颜色"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:gravity="center"
            android:padding="8dp"
            android:visibility="visible"/>
    </LinearLayout>

    <!-- 确定/取消 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="取消"
            android:textSize="16sp"
            android:background="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>
        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="确定"
            android:textSize="16sp"
            android:background="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>