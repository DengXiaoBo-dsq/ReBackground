
<resources>
    <!-- 自定义透明背景圆形进度条对话框 -->
    <style name="CustomProgressDialog" parent="Theme.AppCompat.Light.Dialog">
        <!-- 窗口整体设置 -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>

        <!-- 内容区域背景 -->
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>

        <!-- 进度条样式 -->
        <item name="android:progressBarStyle">@style/CustomProgressBarStyle</item>

        <!-- 文本样式 -->
        <item name="android:textColor">#FF0000</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="PresetButtonStyle" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">80dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/preset_button_bg</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:padding">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>



    <!-- 自定义进度条样式 -->
    <style name="CustomProgressBarStyle" parent="Widget.AppCompat.ProgressBar">
        <item name="android:indeterminateTint">#FF0000</item>   <!-- 进度条颜色 -->
        <item name="android:minWidth">90dp</item>
        <item name="android:minHeight">90dp</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="AlertDialogThemeDark" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">#333333</item>
        <item name="android:colorBackground">#1E1E1E</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#AAAAAA</item>
        <item name="android:colorAccent">#FFFFFF</item> <!-- 按钮文字颜色等 -->
        <item name="buttonBarPositiveButtonStyle">@style/DarkDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DarkDialogButton</item>
    </style>

    <style name="DarkDialogButton" parent="Widget.AppCompat.Button">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">"@android:color/transparent"</item>
    </style>

    <style name="DarkButton" parent="Widget.AppCompat.Button">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">"@android:color/transparent"</item>
    </style>
</resources>

